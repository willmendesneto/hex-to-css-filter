{
  "name": "hex-to-css-filter",
  "version": "6.0.0",
  "description": "hex-to-css-filter - Easy way to generate colors from HEX to CSS Filters",
  "author": "Will Mendes <willmendesneto@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmendesneto/hex-to-css-filter.git"
  },
  "bugs": {
    "url": "https://github.com/willmendesneto/hex-to-css-filter/issues"
  },
  "homepage": "https://github.com/willmendesneto/hex-to-css-filter#readme",
  "sideEffects": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/umd/hex-to-css-filter.min.js",
  "jsdelivr": "dist/umd/hex-to-css-filter.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "hex-to-css-filter",
    "css",
    "filter",
    "hex",
    "color"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist lib coverage .jest",
    "build": "npm run clean && tsc -p tsconfig.build.json && rollup --config",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:ci": "jest --coverage",
    "size": "size-limit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version": "version-changelog CHANGELOG.md && changelog-verify CHANGELOG.md && git add CHANGELOG.md"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "3.5 kB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "3.5 kB"
    },
    {
      "path": "dist/umd/hex-to-css-filter.min.js",
      "limit": "1.85 kB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@size-limit/file": "^14.2.0",
    "@types/jest": "^30.0.0",
    "changelog-verify": "^1.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "rollup-plugin-dts": "^6.5.1",
    "size-limit": "^14.2.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "version-changelog": "^3.1.1"
  }
}
